# Ключ DeepSeek. Получить: https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# deepseek-v4-pro — точнее, deepseek-v4-flash — быстрее и дешевле
DEEPSEEK_MODEL=deepseek-v4-pro

# Модели reasoning-типа: основной бюджет уходит на размышления.
# Замер на неоднозначной заявке: pro ~4 300 токенов, flash ~10 500.
# Меньше 8000 ставить нельзя — ответ оборвётся до JSON.
LLM_MAX_TOKENS=16000
LLM_TIMEOUT=180

# Пусто — режим модели по умолчанию (pro: ~75 с на заявку).
# minimal — сокращает размышления, ответ примерно за 50 с. Удобно для демонстрации.
LLM_REASONING_EFFORT=
